<%
    String topCtx = request.getContextPath();
    Object topNameObj = session.getAttribute("fullName");
    Object topRoleObj = session.getAttribute("role");
    String topName = topNameObj == null ? "Analyst" : topNameObj.toString();
    String topRole = topRoleObj == null ? "USER" : topRoleObj.toString();

    String topInitials = "CS";
    String[] topParts = topName.trim().split("\\s+");
    if (topParts.length > 0 && !topParts[0].isEmpty()) {
        topInitials = topParts[0].substring(0, 1).toUpperCase();
        if (topParts.length > 1 && !topParts[topParts.length - 1].isEmpty()) {
            topInitials += topParts[topParts.length - 1].substring(0, 1).toUpperCase();
        }
    }
%>
<header class="topbar">
    <button class="icon-btn menu-btn" type="button" data-sidebar-toggle
            aria-label="Open navigation">
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"/>
        </svg>
    </button>
    <div class="topbar-title">
        <strong><%= com.cybershield.util.HtmlUtil.escape(pageTitle) %></strong>
        <span>CyberShield operations console</span>
    </div>
    <div class="topbar-spacer"></div>
    <button class="icon-btn" type="button" data-theme-toggle aria-label="Toggle colour theme">
        <svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20 14.5A8 8 0 019.5 4a8 8 0 1010.5 10.5z"/>
        </svg>
        <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="4"/>
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
        </svg>
    </button>
    <div class="user-chip" title="<%= com.cybershield.util.HtmlUtil.escape(topName) %>">
        <span class="avatar"><%= com.cybershield.util.HtmlUtil.escape(topInitials) %></span>
        <span class="user-meta">
            <strong><%= com.cybershield.util.HtmlUtil.escape(topName) %></strong>
            <span><%= com.cybershield.util.HtmlUtil.escape(topRole) %></span>
        </span>
    </div>
    <a class="icon-btn" href="<%= topCtx %>/logout" aria-label="Sign out" title="Sign out">
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M15 4h3a2 2 0 012 2v12a2 2 0 01-2 2h-3"/>
            <path d="M10 8l-4 4 4 4M6 12h9"/>
        </svg>
    </a>
</header>
